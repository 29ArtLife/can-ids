# 数据集（体积大，从官方页面获取 / Release 下载）
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# 注意：data/interim/ 下的 parquet 会入库（约 156MB），
# 这样组员 clone 后无需重新解析。若仓库过大可改回排除。

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# 模型权重与缓存
*.pt
*.pth
*.onnx
*.pkl
*.joblib
.cache/

# 编辑器
.idea/
.vscode/
*.swp

# 系统
.DS_Store
Thumbs.db
